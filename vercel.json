{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!assets/|img/|videos/|sample-quotes/|favicon|robots\\.txt|sitemap\\.xml|llms\\.txt|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
